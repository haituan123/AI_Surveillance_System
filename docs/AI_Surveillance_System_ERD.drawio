yle=&quot;color:#9ec5ff&quot;&gt;INTEGER&lt;/span&gt;&lt;span style=&quot;color:#b8bec8&quot;&gt; — NULL → people.id; ON DELETE SET NULL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #444a52&quot;&gt;&lt;td style=&quot;width:34px;padding:4px 6px;border-right:1px solid #59606a&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 7px&quot;&gt;&lt;b&gt;track_id&lt;/b&gt; &lt;span style=&quot;color:#9ec5ff&quot;&gt;INTEGER&lt;/span&gt;&lt;span style=&quot;color:#b8bec8&quot;&gt; — NULL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #444a52&quot;&gt;&lt;td style=&quot;width:34px;padding:4px 6px;border-right:1px solid #59606a&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 7px&quot;&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style=&quot;color:#9ec5ff&quot;&gt;TEXT&lt;/span&gt;&lt;span style=&quot;color:#b8bec8&quot;&gt; — known | unknown | low_quality&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #444a52&quot;&gt;&lt;td style=&quot;width:34px;padding:4px 6px;border-right:1px solid #59606a&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 7px&quot;&gt;&lt;b&gt;confidence&lt;/b&gt; &lt;span style=&quot;color:#9ec5ff&quot;&gt;REAL&lt;/span&gt;&lt;span style=&quot;color:#b8bec8&quot;&gt; — NULL; CHECK -1.0..1.0&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #444a52&quot;&gt;&lt;td style=&quot;width:34px;padding:4px 6px;border-right:1px solid #59606a&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 7px&quot;&gt;&lt;b&gt;snapshot_path&lt;/b&gt; &lt;span style=&quot;color:#9ec5ff&quot;&gt;TEXT&lt;/span&gt;&lt;span style=&quot;color:#b8bec8&quot;&gt; — NULL&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #444a52&quot;&gt;&lt;td style=&quot;width:34px;padding:4px 6px;border-right:1px solid #59606a&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:4px 7px&quot;&gt;&lt;b&gt;detected_at&lt;/b&gt; &lt;span style=&quot;color:#9ec5ff&quot;&gt