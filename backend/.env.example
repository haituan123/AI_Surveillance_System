BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=*

# Optional. Required only for the Video Q&A answer-generation feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Relative paths are resolved from the backend/ directory.
DATABASE_PATH=database/app.db
DATA_DIR=data
KNOWN_FACES_DIR=data/known_faces
EMBEDDINGS_DIR=data/embeddings
SNAPSHOTS_DIR=data/snapshots
TEST_VIDEOS_DIR=data/test_videos
TEMP_UPLOADS_DIR=data/temp_uploads
MODELS_DIR=models
INSIGHTFACE_ROOT=models/insightface
YOLO_MODELS_DIR=models/yolo

MIN_FACE_IMAGE_WIDTH=80
MIN_FACE_IMAGE_HEIGHT=80
MIN_DETECTED_FACE_SIZE=40
FACE_CROP_PADDING_RATIO=0.25
FACE_CROP_SIZE=160
FACE_DETECTION_THRESHOLD=0.30
FACE_MATCH_THRESHOLD=0.35
PERSON_DETECTION_THRESHOLD=0.40
RECOGNITION_BUFFER_SIZE=10
TRACK_FACE_PADDING_RATIO=0.40
INSIGHTFACE_DET_WIDTH=640
INSIGHTFACE_DET_HEIGHT=640
INSIGHTFACE_MODEL_NAME=buffalo_l
YOLO_MODEL_PATH=models/yolo/yolov8n.pt
CAMERA_READ_FAILURE_LIMIT=5
SURVEILLANCE_STOP_TIMEOUT_SECONDS=5
UNKNOWN_CONFIRMATION_FRAMES=5
ALERT_COOLDOWN_SECONDS=10
RESTRICTED_ZONE_DWELL_SECONDS=5
RESTRICTED_ZONE_ALERT_COOLDOWN_SECONDS=30
VIDEO_UPLOAD_MAX_BYTES=524288000
VIDEO_ANALYSIS_RESULT_TTL_SECONDS=1800
VIDEO_ANALYSIS_STOP_TIMEOUT_SECONDS=5
VIDEO_ANALYSIS_MAX_EVENTS=1000
